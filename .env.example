# Generate a unique token with: openssl rand -hex 32
SANDBOX_API_TOKEN=replace-with-64-hex-character-random-token

# Path to a dedicated ROOTLESS Docker daemon socket, not /var/run/docker.sock.
DOCKER_SOCKET_PATH=/run/user/1000/docker.sock
SANDBOX_UID=1000
SANDBOX_GID=1000

# Absolute project workspace path as seen by the Docker host. Keep it read-only in jobs.
SANDBOX_WORKSPACE_HOST_PATH=/srv/sandboxd/Pages-live

# Exact browser origin for the GitHub Pages site; add your custom domain origin if used.
SANDBOX_ALLOWED_ORIGINS=https://onegayunicorn.github.io
